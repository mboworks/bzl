"""Runfiles lookup-key library and regression tests."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "runfiles_bzl",
    srcs = ["runfiles.bzl"],
    visibility = ["//visibility:public"],
)

alias(
    name = "runfiles",
    actual = ":runfiles_bzl",
    visibility = ["//visibility:public"],
)
